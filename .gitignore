# ==========================================
# C++ & OpenCV Project .gitignore
# ==========================================

# Compiled executables
SignLanguage
TrainModel
CaptureImages
TFLiteTest
*.out
*.exe

# Object files and libraries
*.o
*.a
*.so

# CMake generated files and directories
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
build/

# Datasets (Never commit large image folders)
dataset/

# Machine Learning models (Generated or downloaded)
*.xml
*.tflite

# Logs and debug files
logs/
*.log

# Editor and OS temporary files
*~
*.swp
.DS_Store
.vscode/
.idea/
